#!/usr/bin/env zsh

zparseopts -D -E -F - \
  {-favorites,-history}=zbuiltin_playlist \
  {p,-playlist}:=zplaylist \
  {t,-template}:=ztemplate \
  {-process-all,-process-existing}=zprocess_mode \
  {-link,-embed-all,-embed-rom}=zcontain_mode \
  -mame-tags=zset_tags \
  {h,-help}=zhelp || {
    echo "see --help" >&2
    exit 1
  }

if (( #zhelp ))
then
	cat <<-EOF
	usage: rashortcuts [OPTION]... [OUTPUT]

	Playlists:
	  --favorites         favorites playlist
	  --history           history playlist
	  -p, --playlist      path/to/playlist.lpl

	If a playlist is not provided, fzf will list them automatically.

	Process without fzf game selection.
	  --process-all       Process all entries for a given playlist.
	  --process-existing  Process entries for a given playlist that already exists in
	                      the output directory. Useful for updating existing shortcuts.

	Tag shortcuts based on MAME's internal sourcefile string.
	  --mame-tags         Tags based on internal info, e.g., capcom, cps3.

	Containment mode:
	  --link              Core and game files are symlinked. (default)
	                      For use when the shortcut is already self-contained to
	                      force it into symbolic links.
	  --embed-rom         Copy all rom files into the shortcut.
	  --embed-all         Copy the core and rom files into the shortcut.

	Custom templates:
	  -t, --template      path/to/template-folder

	An optional template for building shortcuts. It defaults to the folder named
	"template" located in the same directory as this script. If a hidden .template
	folder exists in the output directory or its parents, it will be used instead
	but --template will always take presidence.

	Last argument should point to the directory where the shortcut.app will be created.
	Defaults to the current working directory.

	  -h, --help          View help.
	EOF
  exit
fi

thisdir=${0:A:h}
PATH=$thisdir:$PATH

# Systems with ROMS structured around MAME.
arcade_systems=(
  'Atomiswave'
  'FBNeo - Arcade Games'
  'MAME'
  'MAME 2000'
  'MAME 2003'
  'MAME 2003-Plus'
  'MAME 2010'
  'MAME 2015'
  'MAME 2016'
  'Sega - Naomi'
  'Sega - Naomi 2'
)

# Print with style.
function p.header { printf "\n\e[1;30m%s\e[0m\n" $@ }
function p.ok     { printf "\e[0;30m%s\e[0m\n" $@ }
function p.list   { printf " \e[0;30m%s\e[0m\n" $@ }
function p.note   { printf "\e[0;33m%s\e[0m\n" $@ }
function p.lnote  { printf " \e[0;33m%s\e[0m\n" $@ }
function p.error  { printf "\e[0;31m%s\e[0m\n" $@ >&2 }
function p.lerror { printf " \e[0;31m%s\e[0m\n" $@ >&2 }

# Make .icns files.
function m.icns {
  local icnset=${TMPDIR}`uuidgen`.iconset
  mkdir $icnset
  sips -j $thisdir/makeicnset.js $1 -o $icnset
  iconutil -c icns $icnset -o $2
  rm -rf $icnset
}

# Make symbolic link to external dependency.
function m.link {
  zparseopts -D -E - {s,-silent}=zsilent {f,-on-fail}=fsilent || return 1
  local source=$1 target=$shortcut_tmp/Contents/$2 target_dir
  if [[ -f $source ]]
  then
    # If target is a file, link to it. Otherwise, link to a directory.
    # This is determined by a file extension between 1-5 characters.
    if [[ $target =~ \\.[^.]{1,5}$ ]]
    then target_dir=$target:h
    else target_dir=$target
    fi
    [[ -d $target_dir ]] || mkdir -p $target_dir
    ln -sf $source $target
    # Hides message when --silent. It will show on -sf, silent on fail only.
    if ! (( #zsilent )) || (( #fsilent ))
    then p.list "linked: $source:t"
    fi
  else
    # Hides error message when --silent or -sf, silent on fail.
    if ! (( #zsilent )) && ! (( #fsilent ))
    then p.lerror "missing: $source:t"
    fi
    return 1
  fi
}

for skey in config_save_minimal playlist_compression playlist_use_old_format
do
  if [[ $( raconfig --get $skey ) == true ]]
  then p.error "Incompatible with '$skey'."
    exit 1
  fi
done

# oq is a wrapper for jq and share the same options but oq can convert from xml
# which is required for mame roms. @see mameinfo. jq can be used when mame isn't
# a concern and it is faster when dealing solely with json.
if (( $+commands[jq] ))
then jq=jq
elif (( $+commands[oq] ))
then jq=oq
else p.error "jq or oq is required."
  exit 1
fi
# fzf is required for the interactive menu.
if ! (( $+commands[fzf] ))
then p.error "fzf is required."
  exit 1
fi
# macOS 26 >= for custom icons.
iconjail=$(( ${$(sw_vers -productVersion)%%.*} >= 26 ))
if ! (( $+commands[fileicon] )) && (( iconjail ))
then p.error "fileicon is required"
  exit 1
fi
# required only when tagging.
if ! (( $+commands[tag] )) && (( #zset_tags ))
then p.error "tag is required"
  exit 1
fi

output=${1:-.}

# order of precedence:
# - calling with -t|--template <template/path>
# - hidden .template folder in the $output directory and its parents.
# - default template provided with the script.
if [[ -n $ztemplate[-1] ]]
then template=$ztemplate[-1]
else
  find_template=${output:a}
  while [[ ! -s $find_template/.template ]]
  do
    find_template=$find_template:h
    if [[ $find_template == / ]]
    then break
    fi
  done
  if [[ -d $find_template/.template ]]
  then template=$find_template/.template
  else template=$thisdir/template
  fi
fi
# Hidden templates can be easily forgotten. Give notice.
if [[ $template =~ "\/\." ]]
then p.note "Using template: ${${template:a}/#$HOME/~}"
fi
# Basic requirement check for templates.
for f in info.plist MacOS/launcher
do
  if [[ ! -f $template/Contents/$f ]]
  then
    p.error "Check template: $f:t file not found." \
            "- $template/Contents/$f"
    exit 1
  fi
done

if (( ${#zplaylist} ))
then playlist=${zplaylist[-1]}
elif (( ${#zbuiltin_playlist} ))
then playlist=$( raconfig --get content_${zbuiltin_playlist[-1]#--}_path )
else
  playlistdir=$( raconfig --get playlist_directory )
  lplnames=( $playlistdir/*.lpl(N:t:r) )
  playlist=$(
    for lpl in $playlistdir/*.lpl
    do printf "%s\t%s\n" $lpl $lpl:t:r
    # automatically query when the output directory name matches playlist name.
    done | fzf -d '\t' --with-nth 2 --query "${lplnames[(r)$output:t]}" --select-1 --preview "$jq -r '.items[].label' {1}" | cut -f1
  )
  if [[ ! -n $playlist ]]
  then p.note "Nothing selected."
    exit
  fi
fi

if [[ ! -f $playlist ]]
then
  p.error "Playlist does not exist:" \
          "- $playlist"
  exit 1
fi

# tab seperated list from playlist. ensure .label and .db_name are present.
list=$(
  $jq -r '.items[] | select((.label|length > 0) and (.db_name|length > 0)) |
    [ .label,
      .path,
      .core_name,
      .core_path,
      .db_name | sub(".lpl"; "") ] | @tsv' $playlist
)

if (( ${#zprocess_mode} ))
then worklist=$list
else worklist=$( fzf --multi --delimiter $'\t' --with-nth 1 --header "$playlist:t:r" <<< $list )
fi

if [[ -z $worklist ]]
then p.note "Nothing to process."
  exit
fi

scontent_path=$( $jq -r '.scan_content_dir' $playlist )
default_cname=$( $jq -r '.default_core_name' $playlist )
default_cpath=$( $jq -r '.default_core_path' $playlist )

for row in ${(f)worklist}
do
  IFS=$'\t' read -r label gpath cname cpath system <<< $row

  cname=${${cname/DETECT}:-$default_cname}
  cpath=${${cpath/DETECT}:-$default_cpath}

  # Make label file system safe.
  # - replace ':' with '：' [Unicode U+FF1A] and '.'
  # - replace '/' with '᜵'. [Unicode U+1735]
  shortcut_app=$output/${${${label//: /：}//:/.}//\//᜵}.app

  if [[ $zprocess_mode == --process-existing && ! -d $shortcut_app ]]
  then continue
  fi

  if [[ -z $cpath ]]
  then
    p.error "Skipping: $label" \
            "Core could not be determined from the playlist. Do one of the following:" \
            "- Set a default core for the playlist. (recommended)" \
            "- Run the game in RetroArch at least once from the playlist."
    continue
  fi

  # Create the app bundle.
  p.header $shortcut_app:t

  shortcut_tmp=$( mktemp -dt rashortcut )
  if ! cp -Rc $template/Contents $shortcut_tmp
  then
    p.error "Could not create $shortcut_app:t."
    rm -rf $shortcut_tmp
    continue
  fi

  tags=()
  # system:system name taken from the db_name without the lpl extension.
  # cname: core name formatted as 'EMULATED SYSTEM (CORENAME)'
  # cpath: core path.
  # label: name from playlist label field usually taken from a database.
  # gpathextended:full game path including possible archive pointer.
  # gpath: game path without the archived pointer.
  # gcont: game container or parent directory name.
  # gfile: game file name with extension.
  # fname: name of the game file without extension.
  # aname: name of archive pointer. Empty if not present.

  gpathextended=$gpath
  if [[ $gpath =~ "(.*\.[[:alnum:]]{2,3})\#(.*)\.[[:alnum:]]{2,4}$" ]]
  then
    gpath=${match[1]}
    aname=${match[2]}
  else
    aname=
  fi
  gcont=$gpath:h:t
  gfile=$gpath:t
  fname=$gpath:t:r

  # INFO.PLIST: Set bundle id.
  bundleid=com.libretro
  # Limit application bundle id to alphanumerics and '-', all lower case.
  # Cut off everything before the first '- ' in system.
  # Extract everything within '()' from core name.
  # Cut off everything after ' (' and ' [' from the file name.
  for d in ${system#*- } ${${cname#*\(}%)} ${${fname%% \(*}%% \[*}
  do bundleid+=.$( printf %s ${(L)d} | tr -cd '[:alnum:]-' )
  done
  plutil -insert CFBundleIdentifier -string $bundleid $shortcut_tmp/Contents/info.plist
  p.list "bundleID: $bundleid"

  # LAUNCHER: Set system, core and rom.
  plutil -insert EmuSystem -string $system $shortcut_tmp/Contents/info.plist
  Plutil -insert EmuCore -string ${cpath:t} $shortcut_tmp/Contents/info.plist
  plutil -insert EmuROM -string $gcont/$gpathextended:t $shortcut_tmp/Contents/info.plist

  if [[ -f $shortcut_app/Contents/Frameworks/$cpath:t &&
      ! -L $shortcut_app/Contents/Frameworks/$cpath:t &&
        -z $zcontain_mode ]]
  # Do nothing. Core already exists and isn't symlinked.
  then p.list "self-contained: $cpath:t"
  elif ! m.link $cpath Frameworks/$cpath:t
  then
    rm -rf $shortcut_tmp
    p.error Aborted.
    continue
  fi

  if [[ -f $shortcut_app/Contents/Resources/$gcont/$gfile &&
      ! -L $shortcut_app/Contents/Resources/$gcont/$gfile &&
        -z $zcontain_mode ]]
  then
    # Do nothing. ROM already exists and isn't symlinked. If the game file
    # isn't linked, it's expected that dependencies aren't linked either.
    # Simply give feedback on the status of each file.
    for file in $shortcut_app/Contents/Resources/$gcont/*
    do
      if [[ -L $file && ! -e $file ]]
      then p.lnote "broken link: $file:t"
      elif [[ -L $file ]]
      then p.list "existing link: $file:t"
      else p.list "self-contained: $file:t"
      fi
    done
  else
    # Soft link game files and all dependencies.
    # - mame roms dependencies, .e.g., bios, devices, parent roms or disks.
    # - For consoles, files that share the rom name mainly for softpatches.
    # - File pointers within m3u and cue files.

    # Start file and dependency linking.
    if [[ -n ${arcade_systems[(r)$system]} ]]
    then
      if [[ $gpath =~ "(.+)/\.sorted/-.+" ]]
      then gpath=${match[1]}/$gpath:t
      fi
      if ! mameinfo --exists $gpath 2>/dev/null
      then mameinfo --init-path ${gpath:h}
      fi

      typeset -A linked_devices=()
      # Link MAME roms and dependencies.
      sourcedir=$gpath:h name=$gpath:t:r ext=$gpath:e
      targetdir=Resources/$gcont

      while [[ $name != null ]]
      do
        # bios -> parent -> child .. For each dependency get devices and disks.
        rom=$sourcedir/$name.$ext
        # Prevent infinite loop.
        mameinfo --exists $rom || break

        # Strict check on current rom. Dependencies are not since this script
        # doesn't know the if it's using a split or merged set.
        if [[ $sourcedir/$name.$ext == $gpath ]]
        then
          if ! m.link $sourcedir/$name.$ext $targetdir
          then
            rm -rf $shortcut_tmp
            p.error Aborted
            continue 2
          fi
        else
          # Message shows on success, silent on failure.
          m.link -sf $sourcedir/$name.$ext $targetdir
        fi
        # Link json but never show message.
        m.link -s "$( mameinfo --info-path $rom )" $targetdir

        while read -r device
        do
          if ! (( $linked_devices[$device] ))
          then
            m.link -sf $sourcedir/$device.$ext $targetdir
            m.link -s "$( mameinfo --info-path $sourcedir/$device.$ext )" $targetdir
            linked_devices[$device]=1
          fi
        done < <( mameinfo -r '[(.device_ref//[])[].name]|unique|.[]' $rom )

        while read -r disk merge
        do
          # Filter out merge names. They are added with the parent. Disks are in
          # a subdirectory named after the machine name it is associated with.
          if [[ $disk != $merge ]]
          then
            if ! m.link $sourcedir/$name/$disk.chd $targetdir/$name/$disk.chd
            then
              rm -rf $shortcut_tmp
              p.error Aborted
              continue 3
            fi
          fi
        done < <( mameinfo -r '(.disk//[])[]|"\(.name) \(.merge)"' $rom )

        # Broken dependency chain for naomigd roms. Add naomi bios manually.
        if [[ $name == naomigd ]]
        then name=naomi
        else name=$( mameinfo -r .romof $rom )
        fi
      done

      if [[ ${zset_tags[(r)--mame-tags]} ]]
      then
        # tags based on sourcefile string.
        source_strings=${${$( mameinfo -r '.sourcefile' $gpath ):r}/_/\/}
        tags+=( ${(s:/:)source_strings} )
      fi

    else
      # Link console roms and dependencies.
      typeset -aU cuefiles=()
      sourcedir=$gpath:h
      targetdir=Resources/$gcont

      for file in $gpath:r.*
      do
        if ! m.link $file $targetdir
        then
          rm -rf $shortcut_tmp
          p.error Aborted
          continue
        fi
      done

      if [[ $gpath:e == m3u ]]
      then
        # Reading m3u file.
        while read -r file
        do
          if ! m.link $sourcedir/$file $targetdir
          then
            rm -rf $shortcut_tmp
            p.error Aborted
            continue
          fi
          if [[ $file:e == cue ]]
          then cuefiles+=$sourcedir/$file
          fi
        # Ignore Windows CR \r, comments and empty lines.
        done < <( tr -d '\r' < $gpath | grep -vE '^#|^[[:space:]]*$' )
      elif [[ $gpath:e == cue ]]
      then cuefiles+=$gpath
      fi

      for cuefile in $cuefiles
      do
        # Reading cue file.
        while read -r line
        do
          # Account for double, single and no quotes.
          if [[ $line =~ "FILE [\"']?(.+[a-z])[\"']? [A-Z]+" ]]
          then file=${match[1]}
          else
            rm -rf $shortcut_tmp
            p.error "failed to parse $cuefile."
            p.error Aborted.
            continue 2
          fi

          if ! m.link $sourcedir/$file $targetdir
          then
            rm -rf $shortcut_tmp
            p.error Aborted.
            continue 2
          fi
        done < <( grep -E 'FILE' $cuefile )
      done
    fi
    # End file and dependency linking.
  fi

  typeset -aU thumbnames=(
    $fname
    $aname
    $label
  )

  # For each name in $thumbnames:
  # - Chop off each occurance of `(.*)` or `[.*]` from the trailing end.
  # - Add each iteration to the list of naming candidates.
  for _name in $thumbnames; while [[ $_name =~ "^(.+)(\(|\[)([^([]*)(\)|\]).*$" ]]
  do
    _name=$match[1]
    # Discard trailing spaces.
    thumbnames+=${_name%${_name##*[! ]}}
  done

  appicon=$shortcut_app/Contents/Resources/AppIcon.icns
  tmpicon=$shortcut_tmp/Contents/Resources/AppIcon.icns
  unset thumbpath
  update_icon=0
  for thumb in $thumbnames
  do
    # Mimic RetroArch's safe naming for thumbnails.
    thumb=$( printf %s $thumb | tr '&*/:\`<>?\|' '_' )
    thumbpath=$( raconfig --get thumbnails_directory )/$system/Named_Boxarts/$thumb.png
    if [[ -f $thumbpath ]]
    then
      p.list "boxart/$thumb.png -> $tmpicon:t"
      if [[ ! -f $appicon || $thumbpath -nt $appicon ]]
      then
        m.icns $thumbpath $tmpicon
        update_icon=1
      fi
      break
    fi
  done

  # Use RetroSystem XMB theme content icon as a fallback.
  if [[ ! -f $thumbpath ]]
  then
    fallback=$( raconfig --get assets_directory )/xmb/retrosystem/png/$system-content.png
    if [[ -f $fallback ]]
    then
      p.lnote "retrosystem/$system-content.png -> $tmpicon:t"
      if [[ ! -f $appicon || $fallback -nt $appicon ]]
      then
        m.icns $fallback $tmpicon
        update_icon=1
      fi
    else
      p.error "$tmpicon:t not copied."
    fi
  fi

  if [[ -d $shortcut_app ]]
  then
    p.ok "Finalizing update.."
  else
    p.ok "Finalizing.."
    mkdir -p $shortcut_app
  fi

  clone_dir=()
  if [[ $zcontain_mode == --embed-all ]]
  then clone_dir=( $shortcut_tmp/Contents/{FrameWorks,Resources/$gcont} )
  elif [[ $zcontain_mode == --embed-rom ]]
  then clone_dir=( $shortcut_tmp/Contents/Resources/$gcont )
  fi
  if (( ${#clone_dir} ))
  then
    find $clone_dir -type l | while read -r link
    do
      # prepare source and destination. copying into a symbolic link
      # causes a permission error that can not be avoided.
      applink=$shortcut_app/${link#$shortcut_tmp/}
      if [[ -f $applink ]]
      then rm $applink
      fi
      cp -Lc $link $link.tmp && mv $link.tmp $link
      p.lnote "copied $( du -h $link | cut -f1 ): ${link:t}"
    done
  fi

  if cp -ac $shortcut_tmp/Contents $shortcut_app
  then
    chmod +x $shortcut_app/Contents/MacOS/launcher
    # Work around Tahoe's icon jail.
    if (( update_icon && iconjail ))
    then fileicon set -q $shortcut_app $appicon &
    fi
    if (( ${#tags} ))
    then
      tag -a ${(j:,:)tags} $shortcut_app
      p.list "tagged: ${(j:,:)tags}"
    fi
    p.list "total size: $( du -sh $shortcut_app | cut -f1 )"
    # Update modification date.
    touch $shortcut_app
  else
    p.error "Unable to finalize $shortcut_app:t."
  fi
  rm -rf $shortcut_tmp

done
